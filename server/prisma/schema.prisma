generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExpenseByCategory {
  expenseByCategoryId String         @id @default(uuid())
  expenseSummaryId    String
  category            String
  amount              Decimal        @db.Decimal(15, 2)
  date                DateTime
  ExpenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId])
}

model ExpenseSummary {
  expenseSummaryId  String              @id @default(uuid())
  totalExpenses     Decimal             @db.Decimal(15, 2)
  date              DateTime
  ExpenseByCategory ExpenseByCategory[]
}

model Expenses {
  expenseId String   @id @default(uuid())
  category  String
  amount    Decimal  @db.Decimal(15, 2)
  timestamp DateTime
}

model Products {
  productId     String      @id @default(uuid())
  name          String
  price         Decimal     @db.Decimal(15, 2)
  rating        Float?
  stockQuantity Int
  Purchases     Purchases[]
  Sales         Sales[]
}

model PurchaseSummary {
  purchaseSummaryId String   @id @default(uuid())
  totalPurchased    Decimal  @db.Decimal(15, 2)
  changePercentage  Float?
  date              DateTime
}

model Purchases {
  purchaseId String   @id @default(uuid())
  productId  String
  timestamp  DateTime
  quantity   Int
  unitCost   Decimal  @db.Decimal(15, 2)
  totalCost  Decimal  @db.Decimal(15, 2)
  Products   Products @relation(fields: [productId], references: [productId])
}

model Sales {
  saleId      String   @id @default(uuid())
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Decimal  @db.Decimal(15, 2)
  totalAmount Decimal  @db.Decimal(15, 2)
  Products    Products @relation(fields: [productId], references: [productId])
}

model SalesSummary {
  salesSummaryId   String   @id @default(uuid())
  totalValue       Decimal  @db.Decimal(15, 2)
  changePercentage Float?
  date             DateTime
}

model Users {
  userId String @id @default(uuid())
  name   String
  email  String
}
